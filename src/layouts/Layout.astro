---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  currentPath: string;
  /** URL of this page's LCP image (e.g. from getImage()), preloaded with high priority. */
  preloadImage?: string;
}

const {
  title,
  description = 'Auto Assist 24/7 provides dependable, pay-as-you-go emergency roadside assistance across the UK — vehicle recovery, jump starts and mobile tyre fitting, 24 hours a day.',
  currentPath,
  preloadImage,
} = Astro.props;

const canonicalUrl = new URL(currentPath, Astro.site);
const ogImageUrl = new URL('/og-image.webp', Astro.site);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Auto Assist 24/7" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    <!--
      Fonts are self-hosted (src/styles/global.css) rather than loaded from
      fonts.googleapis.com: that removed two render-blocking cross-origin
      requests, plus the JS "swap stylesheet on load" trick previously used
      to avoid blocking on them, from the critical rendering path. Preload
      the two text fonts (not the much larger icon font, which isn't part
      of the LCP text) so they're fetched immediately in parallel with the
      page's own CSS.
    -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/plusjakartasans-latin.woff2" crossorigin />
  </head>
  <body class="bg-surface-container-lowest text-on-surface font-body-md text-body-md antialiased min-h-screen relative selection:bg-primary-container selection:text-on-primary-container">
    <div class="pointer-events-none fixed inset-0 z-0 bg-[radial-gradient(circle_at_top_center,rgba(0,242,254,0.06),transparent_50%),radial-gradient(circle_at_bottom_right,rgba(0,228,120,0.03),transparent_40%)]">
    </div>
    <Header currentPath={currentPath} />
    <main class="relative w-full pt-20 bg-transparent min-h-[calc(100vh-80px)] pb-space-2xl md:pb-0 z-10">
      <slot />
    </main>
    <Footer currentPath={currentPath} />
  </body>
</html>
