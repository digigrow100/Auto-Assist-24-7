<script>
  const spotlight = document.getElementById('ambient-spotlight');
  if (spotlight && window.matchMedia('(pointer: fine)').matches) {
    window.addEventListener('pointermove', (e) => {
      spotlight.style.background = `radial-gradient(600px at ${e.clientX}px ${e.clientY}px, rgba(0, 242, 254, 0.04), transparent 80%)`;
    });
  }

  document.querySelectorAll('.value-card').forEach((card) => {
    card.addEventListener('mouseenter', () => card.classList.add('shadow-[0_0_20px_rgba(0,242,254,0.15)]'));
    card.addEventListener('mouseleave', () => card.classList.remove('shadow-[0_0_20px_rgba(0,242,254,0.15)]'));
  });
</script>
