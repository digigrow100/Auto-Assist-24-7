---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="About Us | Auto Assist 24/7"
  description="Auto Assist 24/7 provides dependable, pay-as-you-go emergency roadside assistance for British drivers facing breakdowns, depleted batteries, and tyre failures — without binding annual contracts."
  currentPath="/about"
>
  <div class="flex flex-col w-full">
    <div class="pointer-events-none fixed inset-0 z-0 transition-opacity duration-500 opacity-70" id="ambient-spotlight"></div>

    <!-- SECTION 1: ABOUT HERO -->
    <section class="relative w-full max-w-7xl mx-auto px-gutter-sm lg:px-margin pt-space-md pb-space-2xl z-10">
      <div class="flex flex-col gap-space-lg">
        <div class="flex flex-wrap items-center gap-space-sm">
          <span class="inline-flex items-center gap-space-xs px-space-md py-space-xs rounded-full bg-surface-container-low text-primary-container font-label-sm text-label-sm uppercase tracking-widest shadow-[0_0_16px_rgba(0,242,254,0.15)]">
            <span class="w-1.5 h-1.5 rounded-full bg-primary-container animate-pulse"></span>
            ABOUT AUTO ASSIST 24/7 • INDEPENDENT UK ROADSIDE RESCUE
          </span>
          <span class="text-on-surface-variant font-label-sm text-label-sm uppercase tracking-wider hidden sm:inline-block">GB FLEET TELEMETRY • OPS REF: AA-2400</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-end">
          <div class="lg:col-span-8">
            <h1 class="text-on-surface font-headline-lg-mobile lg:font-display-hero text-headline-lg-mobile lg:text-display-hero tracking-tight">
              Built To Help Drivers When The Road Doesn't Cooperate.
            </h1>
          </div>
          <div class="lg:col-span-4 pb-space-xs">
            <p class="text-on-surface-variant font-body-lg text-body-lg">
              Auto Assist 24/7 provides dependable, pay-as-you-go emergency roadside assistance for British drivers facing breakdowns, depleted batteries, and tyre failures — without binding annual contracts.
            </p>
          </div>
        </div>

        <div class="relative w-full rounded-xl overflow-hidden bg-surface-container shadow-2xl mt-space-sm">
          <div class="relative w-full h-[360px] md:h-[480px] lg:h-[560px]">
            <img
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuDejVieciOHojxWQAtrwqCIEV-69OezWTZaC9i9ES0vPp0wSSTDN5vfDHhJY8nO7FxaVWhrtte7vWc7zJnI9xqCM9L9DGwh7lqVL4As5_g_X1OD1XgUAJCQHNk1nOJMjN5pFU1QVHLIlAMWz8KO8cz5VTs2H8BkfgE-54bPla7B4u67kcw54arfdHlUrqZnJDNrh0CSNSU2twUKFYCIWJJoe8YU5bX498IdUYwZasnpNaopzRuVLLC4FA"
              alt="Cinematic night view of a UK flatbed vehicle recovery transporter on a wet rainy British motorway hard shoulder, with amber and cyan emergency beacon lights and a roadside rescue crew in high-vis gear."
              width="1600"
              height="900"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-surface-container-lowest/30 to-transparent"></div>
            <div class="absolute inset-0 bg-gradient-to-r from-surface-container-lowest/80 via-transparent to-surface-container-lowest/40"></div>

            <div class="absolute bottom-space-lg left-space-md right-space-md md:left-space-xl md:right-space-xl flex flex-wrap items-end justify-between gap-space-md p-space-md rounded-lg bg-surface-container-lowest/80 backdrop-blur-xl">
              <div class="flex items-center gap-space-lg">
                <div class="flex flex-col">
                  <span class="text-on-surface-variant font-label-sm text-label-sm uppercase">GB DISPATCH LATENCY</span>
                  <span class="text-secondary-fixed-dim font-metric-mono text-headline-sm">48 SEC</span>
                </div>
                <div class="w-px h-8 bg-surface-variant hidden sm:block"></div>
                <div class="flex flex-col">
                  <span class="text-on-surface-variant font-label-sm text-label-sm uppercase">AVERAGE ARRIVAL</span>
                  <span class="text-primary-container font-metric-mono text-headline-sm">34 MINS</span>
                </div>
                <div class="w-px h-8 bg-surface-variant hidden md:block"></div>
                <div class="flex flex-col hidden md:flex">
                  <span class="text-on-surface-variant font-label-sm text-label-sm uppercase">MODEL</span>
                  <span class="text-on-surface font-label-lg text-label-lg">PAY-AS-YOU-GO • NO SUB</span>
                </div>
              </div>
              <div class="flex items-center gap-space-xs">
                <span class="material-symbols-outlined text-secondary-fixed-dim text-[18px]">verified</span>
                <span class="text-on-surface font-label-sm text-label-sm uppercase">IVR • ISO 9001 VERIFIED DISPATCH</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: OUR STORY / WHO WE ARE -->
    <section class="relative w-full max-w-7xl mx-auto px-gutter-sm lg:px-margin py-space-2xl z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-start">
        <div class="lg:col-span-5 flex flex-col gap-space-md lg:sticky lg:top-28">
          <span class="text-primary-container font-label-sm text-label-sm uppercase tracking-widest">ORIGIN • UK ROADWAYS</span>
          <h2 class="text-on-surface font-headline-lg text-headline-lg">
            Roadside Problems Can Happen Anytime. Getting Help Shouldn't Be Complicated.
          </h2>
          <div class="w-16 h-1 bg-primary-container shadow-[0_0_12px_rgba(0,242,254,0.6)]"></div>
          <p class="text-on-surface-variant font-body-md text-body-md pt-space-xs">
            Founded on the principle that drivers deserve instant physical response rather than tiered insurance scripts, Auto Assist 24/7 re-engineers vehicle recovery for the modern British driver.
          </p>
        </div>

        <div class="lg:col-span-7 flex flex-col gap-space-xl">
          <div class="p-space-lg rounded-xl bg-surface-container shadow-xl">
            <h3 class="text-primary font-headline-md text-headline-md mb-space-sm">Eliminating the Legacy Breakdown Trap</h3>
            <p class="text-on-surface-variant font-body-md text-body-md leading-relaxed">
              For decades, UK motorists have been forced into costly annual club subscriptions just for the reassurance that someone will pick up the phone. Yet when an alternator fails on the M1 at 2 AM, those same motor clubs place distressed drivers in 4-hour queues while call centres shuffle paperwork.
            </p>
            <p class="text-on-surface-variant font-body-md text-body-md leading-relaxed mt-space-md">
              Auto Assist 24/7 was created to dismantle that antiquated structure. We engineered an on-demand, contract-free emergency logistics network spanning England, Scotland, and Wales. When you call or request dispatch, an actual local logistics controller assigns an ISO-accredited recovery specialist within minutes.
            </p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
            <div class="p-space-md rounded-lg bg-surface-container-low">
              <span class="material-symbols-outlined text-primary-container text-[28px] mb-space-xs">speed</span>
              <h4 class="text-on-surface font-headline-sm text-headline-sm mb-space-xs">Direct Logistics</h4>
              <p class="text-on-surface-variant font-body-sm text-body-sm">
                Zero call-centre triage layers. Direct voice link and cellular telemetry between you and the incoming driver.
              </p>
            </div>
            <div class="p-space-md rounded-lg bg-surface-container-low">
              <span class="material-symbols-outlined text-secondary-fixed-dim text-[28px] mb-space-xs">currency_pound</span>
              <h4 class="text-on-surface font-headline-sm text-headline-sm mb-space-xs">Capped Transparent Cost</h4>
              <p class="text-on-surface-variant font-body-sm text-body-sm">
                Guaranteed upfront quote issued before any truck turns a wheel. Absolutely zero post-recovery surprise surcharges.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: OUR MISSION -->
    <section class="relative w-full max-w-7xl mx-auto px-gutter-sm lg:px-margin py-space-xl z-10">
      <div class="relative w-full rounded-2xl p-space-xl md:p-space-2xl bg-surface-container-lowest/80 backdrop-blur-2xl shadow-[0_20px_50px_-10px_rgba(0,0,0,0.8),0_0_30px_rgba(0,242,254,0.1)] overflow-hidden">
        <div class="absolute -top-px left-1/4 right-1/4 h-px bg-gradient-to-r from-transparent via-primary-container to-transparent shadow-[0_0_16px_rgba(0,242,254,0.8)]"></div>
        <div class="max-w-3xl mx-auto text-center flex flex-col items-center gap-space-md relative z-10">
          <span class="px-space-md py-space-xs rounded-full bg-surface-container text-primary-container font-label-sm text-label-sm uppercase tracking-widest">
            CORE DOCTRINE
          </span>
          <h2 class="text-on-surface font-headline-lg text-headline-lg">Our Operational Mission</h2>
          <p class="text-primary font-body-lg text-body-lg leading-relaxed italic max-w-2xl">
            "To deliver calm, dependable roadside assistance in a clear, professional, and practical way — putting the driver's safety and convenience first, every hour of the day or night."
          </p>
          <div class="flex flex-wrap items-center justify-center gap-space-sm pt-space-lg">
            {['Reliable', 'Professional', 'Responsive', 'Available 24/7', 'Transparent', 'Practical'].map((word) => (
              <button
                type="button"
                class="group px-space-md py-space-xs rounded-full bg-surface-container hover:bg-primary-container hover:text-on-primary-container text-on-surface font-label-md text-label-md transition-all transform hover:scale-105 shadow-md"
              >
                <span class="inline-block w-1.5 h-1.5 rounded-full bg-primary-container group-hover:bg-on-primary-container mr-space-xs"></span>
                {word}
              </button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: VALUES SECTION -->
    <section class="relative w-full max-w-7xl mx-auto px-gutter-sm lg:px-margin py-space-2xl z-10">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md mb-space-xl">
        <div>
          <span class="text-primary-container font-label-sm text-label-sm uppercase tracking-widest">DISPATCH STANDARDS</span>
          <h2 class="text-on-surface font-headline-lg text-headline-lg">Five Operational Commitments</h2>
        </div>
        <p class="text-on-surface-variant font-body-sm text-body-sm max-w-sm">
          Every incident handled by Auto Assist 24/7 adheres strictly to our non-negotiable service governance.
        </p>
      </div>

      <div class="flex flex-col gap-space-sm">
        {[
          { title: 'Reliability', desc: 'Immediate dispatch readiness with guaranteed upfront quotes before any recovery truck rolls.' },
          { title: 'Professionalism', desc: 'Certified technicians operating purpose-built flatbeds and diagnostic workshop vans.' },
          { title: 'Clear Communication', desc: 'Real-time SMS vehicle tracking, direct driver telephone contact, and accurate arrival windows.' },
          { title: 'Roadside Availability', desc: '24/7/365 active operations desk staffed by real logistics coordinators, never dead-end chatbots.' },
          { title: 'Careful Vehicle Handling', desc: 'Low-approach beds for lowered sports cars, soft-tie wheel strapping, and surge-protected electronics safeguarding.' },
        ].map((value, index) => (
          <div class="value-card group relative p-space-lg rounded-xl bg-surface-container hover:bg-surface-container-high transition-all cursor-pointer shadow-lg">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-space-md">
              <div class="flex items-start md:items-center gap-space-lg">
                <span class="text-primary-container font-metric-mono text-headline-sm opacity-80 group-hover:opacity-100 transition-opacity">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <div class="flex flex-col">
                  <span class="text-on-surface font-headline-md text-headline-md group-hover:text-primary transition-colors">{value.title}</span>
                  <span class="text-on-surface-variant font-body-md text-body-md mt-space-xs">{value.desc}</span>
                </div>
              </div>
              <div class="flex items-center gap-space-xs text-on-surface-variant group-hover:text-primary-container transition-colors self-end md:self-center">
                <span class="font-label-sm text-label-sm uppercase">SPEC REQ</span>
                <span class="material-symbols-outlined text-[20px]">arrow_forward</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- SECTION 5: WHAT WE DO -->
    <section class="relative w-full max-w-7xl mx-auto px-gutter-sm lg:px-margin py-space-2xl z-10">
      <div class="flex flex-col gap-space-lg">
        <div class="flex flex-wrap items-end justify-between gap-space-md">
          <div>
            <span class="text-primary-container font-label-sm text-label-sm uppercase tracking-widest">DEPLOYMENT CAPABILITIES</span>
            <h2 class="text-on-surface font-headline-lg text-headline-lg">What We Do</h2>
          </div>
          <a class="group inline-flex items-center gap-space-xs text-primary font-label-lg text-label-lg hover:text-primary-container transition-colors" href="/services">
            <span>Explore Our Services</span>
            <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
          {[
            {
              tag: 'HEAVY & LIGHT',
              tagColor: 'text-primary-container',
              title: 'Vehicle Recovery',
              desc: 'Full tilt-tray flatbed recovery for breakdowns, highway mechanical stalls, steering faults, and collision extractions.',
              foot: 'UP TO 3.5 TONNE',
              icon: 'local_shipping',
              iconColor: 'text-primary',
              hoverColor: 'group-hover:text-primary-container',
              img: 'https://lh3.googleusercontent.com/aida-public/AB6AXuAJ6IcRu1nzmwkEqzODZfFK-kr-CmAX6gQzy9D_tYJ2h3Rn98EHvOZ8PteM_44veiRxwZ2XHYKco6TZKrtDaPCqwPF-GQJij3tA7_aiVOPHcaDOYPvwnEE2KvWX2svOKFQ7MyhPbJdBopMmQrl53yhv9k66ArlUctTew4jgy4ddQKySAAVF_wifj17K23ljD-mpI6vGs-AGTrxyLMM_d_V2A3CejbxvtLXVpqnR1I1wttOwd5Uw__MGEA',
              alt: 'Close-up of a modern flatbed vehicle recovery truck loading a premium saloon onto hydraulic tilt-tray ramps at night.',
            },
            {
              tag: '12V • 24V RAPID',
              tagColor: 'text-secondary-fixed-dim',
              title: 'Jump Start',
              desc: 'ECU-safe 12V battery revival and charging circuit alternator analysis to get your engine turning over safely without electronics damage.',
              foot: 'SURGE-PROTECTED',
              icon: 'battery_charging_full',
              iconColor: 'text-secondary-fixed-dim',
              hoverColor: 'group-hover:text-secondary-fixed-dim',
              img: 'https://lh3.googleusercontent.com/aida-public/AB6AXuBJNbrUxynUGF8zDH64LRkLFspEmr7GIxlc2sgwCCSlzzb_oYGEreq7pYtaMMqFN2wHBIydkmMIKo2MeOjgjgOedOnrThKtqrrDNF5RqSD8nhVtLDTSI9lthab23NEPKLB1nsV6o6H0KljYGdRuaHQKF2R0fp5zBw8N7edZdP8nfsUlDSwR63h896KN4KZXeIFwKMYwl6MrrXmvxHDty3VUjKHwHN8oI1C0nwxjmzTko_eF_lPi01IjZw',
              alt: 'Automotive technician using a digital battery analyzer and jump pack on a modern hybrid car engine bay.',
            },
            {
              tag: 'ALL SIZES IN STOCK',
              tagColor: 'text-tertiary-fixed',
              title: 'Mobile Tyres',
              desc: 'Roadside puncture replacement, mobile valve fitting, and high-speed laser wheel balancing deployed straight to your exact pin.',
              foot: 'ON-SITE FITTING',
              icon: 'tire_repair',
              iconColor: 'text-tertiary-fixed',
              hoverColor: 'group-hover:text-tertiary-container',
              img: 'https://lh3.googleusercontent.com/aida-public/AB6AXuDlOrwSs7VVZtCc5fus7uGryAdBIJJrH8qYVzVxk0oCpfvniEFdBPQ36B_3JBL4gBTuRRSTxX421DlBlS7YUKnunVNDw-ChdfoXb41ERL7cH4ieaMKYy5XyaA0eWfcx5bAlUbqccVmCf6iqvumlLbb0GNjSyK2ZF9yIIzqooZIK77yMPP4j4jYet27E8TinkTPKY9j2y2q_OQrfduj2COZ56SDJiMEDJ3QflU98PMH1EzPPyS7UMLz9NA',
              alt: 'Mobile tyre technician replacing a roadside tyre beside a fully equipped mobile workshop van at night.',
            },
          ].map((service) => (
            <div class="group flex flex-col rounded-xl bg-surface-container overflow-hidden shadow-xl hover:-translate-y-1 transition-all duration-300">
              <div class="h-60 w-full relative">
                <img
                  src={service.img}
                  alt={service.alt}
                  width="800"
                  height="600"
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 w-full h-full object-cover"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-surface-container via-surface-container/20 to-transparent"></div>
                <div class="absolute top-space-sm left-space-sm">
                  <span class={`px-space-sm py-space-xs rounded bg-surface-container-lowest/80 backdrop-blur font-label-sm text-label-sm ${service.tagColor} uppercase`}>
                    {service.tag}
                  </span>
                </div>
              </div>
              <div class="p-space-lg flex flex-col flex-1 justify-between">
                <div>
                  <h3 class={`text-on-surface font-headline-sm text-headline-sm mb-space-xs ${service.hoverColor} transition-colors`}>{service.title}</h3>
                  <p class="text-on-surface-variant font-body-sm text-body-sm">{service.desc}</p>
                </div>
                <div class="pt-space-md mt-space-md flex items-center justify-between border-t border-white/5">
                  <span class="text-on-surface-variant font-label-sm text-label-sm uppercase">{service.foot}</span>
                  <span class={`material-symbols-outlined ${service.iconColor} text-[20px]`}>{service.icon}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- SECTION 6: INTERACTIVE ORBIT SECTION -->
    <section class="relative w-full max-w-7xl mx-auto px-gutter-sm lg:px-margin py-space-2xl z-10 overflow-hidden">
      <div class="text-center mb-space-xl">
        <span class="text-primary-container font-label-sm text-label-sm uppercase tracking-widest">NETWORK TOPOLOGY</span>
        <h2 class="text-on-surface font-headline-lg text-headline-lg">Coordinated National Framework</h2>
      </div>

      <div class="relative w-full max-w-3xl mx-auto aspect-square max-h-[500px] flex items-center justify-center">
        <svg class="absolute inset-0 w-full h-full pointer-events-none opacity-40 motion-safe:animate-[spin_120s_linear_infinite]" viewBox="0 0 500 500">
          <circle class="text-outline-variant" cx="250" cy="250" fill="none" r="220" stroke="currentColor" stroke-dasharray="4 8" stroke-width="1"></circle>
          <circle class="text-primary-container/40" cx="250" cy="250" fill="none" r="150" stroke="currentColor" stroke-dasharray="2 6" stroke-width="1"></circle>
          <circle class="text-outline-variant/30" cx="250" cy="250" fill="none" r="80" stroke="currentColor" stroke-width="1"></circle>
        </svg>

        <div class="relative z-10 w-48 h-48 rounded-full bg-surface-container-lowest/90 backdrop-blur-2xl flex flex-col items-center justify-center p-space-sm text-center shadow-[0_0_40px_rgba(0,242,254,0.3)]">
          <div class="w-3 h-3 rounded-full bg-secondary-fixed-dim animate-ping mb-space-xs"></div>
          <span class="text-primary font-headline-sm text-headline-sm leading-none">AUTO ASSIST</span>
          <span class="text-primary-container font-headline-md text-headline-md leading-none mb-space-xs">24/7</span>
          <span class="text-on-surface-variant font-label-sm text-label-sm uppercase">UK DISPATCH</span>
        </div>

        <div class="absolute top-4 left-1/2 -translate-x-1/2 px-space-md py-space-xs rounded-full bg-surface-container-high/90 backdrop-blur text-on-surface font-label-sm text-label-sm uppercase shadow-lg flex items-center gap-space-xs">
          <span class="w-2 h-2 rounded-full bg-primary-container"></span> 24/7 Support
        </div>
        <div class="absolute bottom-6 left-1/2 -translate-x-1/2 px-space-md py-space-xs rounded-full bg-surface-container-high/90 backdrop-blur text-on-surface font-label-sm text-label-sm uppercase shadow-lg flex items-center gap-space-xs">
          <span class="w-2 h-2 rounded-full bg-secondary-fixed-dim"></span> Recovery Fleet
        </div>
        <div class="absolute left-2 top-1/3 -translate-y-1/2 px-space-md py-space-xs rounded-full bg-surface-container-high/90 backdrop-blur text-on-surface font-label-sm text-label-sm uppercase shadow-lg flex items-center gap-space-xs">
          <span class="w-2 h-2 rounded-full bg-primary"></span> Battery Diagnostics
        </div>
        <div class="absolute right-2 top-1/3 -translate-y-1/2 px-space-md py-space-xs rounded-full bg-surface-container-high/90 backdrop-blur text-on-surface font-label-sm text-label-sm uppercase shadow-lg flex items-center gap-space-xs">
          <span class="w-2 h-2 rounded-full bg-tertiary-fixed"></span> Mobile Tyres
        </div>
        <div class="absolute left-6 bottom-1/4 px-space-md py-space-xs rounded-full bg-surface-container-high/90 backdrop-blur text-on-surface font-label-sm text-label-sm uppercase shadow-lg flex items-center gap-space-xs">
          <span class="w-2 h-2 rounded-full bg-secondary-fixed"></span> Professional Crew
        </div>
        <div class="absolute right-6 bottom-1/4 px-space-md py-space-xs rounded-full bg-surface-container-high/90 backdrop-blur text-on-surface font-label-sm text-label-sm uppercase shadow-lg flex items-center gap-space-xs">
          <span class="w-2 h-2 rounded-full bg-error"></span> Roadside Safety
        </div>
      </div>
    </section>

    <!-- SECTION 7: OUR APPROACH -->
    <section class="relative w-full max-w-7xl mx-auto px-gutter-sm lg:px-margin py-space-2xl z-10">
      <div class="flex flex-col gap-space-md mb-space-xl">
        <span class="text-primary-container font-label-sm text-label-sm uppercase tracking-widest">INCIDENT EXECUTION</span>
        <h2 class="text-on-surface font-headline-lg text-headline-lg">Our Approach</h2>
        <p class="text-on-surface-variant font-body-md text-body-md max-w-xl">
          A deterministic four-phase methodology ensuring safety, speed, and continuous transparency from initial breakdown ping to roadside resolution.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter relative">
        {[
          { num: '01', icon: 'hearing', title: 'Listen', desc: 'We intake critical safety facts, assess highway danger status, identify passenger needs, and establish immediate hazard precautions.', numColor: 'text-primary-container', iconColor: 'text-primary' },
          { num: '02', icon: 'fmd_good', title: 'Locate', desc: "Pinpoint GPS coordinates or what3words positioning combined with roadside motorway marker post cross-referencing.", numColor: 'text-primary-container', iconColor: 'text-primary' },
          { num: '03', icon: 'navigation', title: 'Respond', desc: "Nearest appropriate certified unit mobilized with exact ETA streamed directly to the stranded driver's smartphone.", numColor: 'text-primary-container', iconColor: 'text-secondary-fixed-dim' },
          { num: '04', icon: 'task_alt', title: 'Assist', desc: 'Safe extraction, roadside repair, or secure vehicle transit to your requested home address or certified garage.', numColor: 'text-secondary-fixed-dim', iconColor: 'text-secondary-fixed-dim' },
        ].map((step) => (
          <div class="relative flex flex-col p-space-lg rounded-xl bg-surface-container shadow-xl">
            <div class="flex items-center justify-between mb-space-md">
              <span class={`${step.numColor} font-metric-mono text-headline-sm`}>{step.num}</span>
              <span class={`material-symbols-outlined ${step.iconColor} text-[24px]`}>{step.icon}</span>
            </div>
            <h3 class="text-on-surface font-headline-sm text-headline-sm mb-space-xs">{step.title}</h3>
