<script>
  const form = document.getElementById('roadside-form') as HTMLFormElement | null;
  const feedback = document.getElementById('form-feedback');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    feedback?.classList.remove('hidden');
    feedback?.classList.add('flex');
    form.reset();
  });

  document.getElementById('use-gps')?.addEventListener('click', () => {
    const input = document.getElementById('breakdown-loc') as HTMLInputElement | null;
    if (!navigator.geolocation || !input) return;
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        input.value = `GPS: ${pos.coords.latitude.toFixed(5)}, ${pos.coords.longitude.toFixed(5)}`;
      },
      () => {
        alert('Please enter your location manually.');
      }
    );
  });
</script>
