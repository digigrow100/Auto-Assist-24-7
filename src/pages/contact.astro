---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import intakeImg from '../assets/images/09-motorway-recovery-dusk.webp';
import mapImg from '../assets/images/10-uk-motorway-interchange.webp';
---

<Layout
  title="Contact | Auto Assist 24/7"
  description="Contact Auto Assist 24/7 for immediate roadside vehicle recovery, battery boost, flatbed towing, or mobile puncture assistance anywhere in the UK."
  currentPath="/contact"
>
  <div class="flex flex-col w-full text-on-surface">
    <!-- 1. HERO SECTION -->
    <section class="relative w-full px-gutter-sm lg:px-margin pt-space-xl lg:pt-space-2xl pb-space-xl overflow-hidden">
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[720px] h-[280px] bg-primary-container/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute top-1/3 right-10 w-[360px] h-[360px] bg-secondary-fixed-dim/5 rounded-full blur-2xl pointer-events-none"></div>

      <div class="max-w-7xl mx-auto flex flex-col gap-space-lg relative z-10">
        <div class="flex flex-wrap items-center gap-space-sm">
          <div class="inline-flex items-center gap-space-xs px-space-md py-1.5 rounded-full bg-surface-container-low shadow-sm shadow-black/40">
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-secondary-fixed-dim opacity-80"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-secondary-fixed-dim"></span>
            </span>
            <span class="font-label-sm text-label-sm text-primary tracking-widest uppercase">CONTACT AUTO ASSIST 24/7 • DISPATCH DESK OPEN NOW</span>
          </div>
          <div class="hidden sm:inline-flex items-center gap-1.5 px-space-sm py-1 rounded-full bg-surface-container-high/60 text-secondary-fixed-dim font-label-sm text-label-sm">
            <span class="material-symbols-outlined text-[14px]">satellite_alt</span>
            <span>TELEMETRY ACTIVE: 320+ FLEET UNITS ONLINE</span>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-end">
          <div class="lg:col-span-8 flex flex-col gap-space-md">
            <h1 class="font-headline-lg-mobile lg:font-display-hero text-headline-lg-mobile lg:text-display-hero tracking-tight text-on-surface">
              Need Help? <br class="hidden sm:block" />
              <span class="text-primary-container drop-shadow-[0_0_24px_rgba(0,242,254,0.35)]">Tell Us Where You Are.</span>
            </h1>
            <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl leading-relaxed">
              For immediate roadside vehicle recovery, high-voltage battery boost, flatbed towing, or mobile puncture assistance, connect directly to our centralized UK operations deck.
            </p>
          </div>

          <div class="lg:col-span-4 flex flex-col gap-space-sm p-space-md rounded-xl bg-surface-container-low shadow-xl">
            <div class="flex items-center justify-between">
              <span class="font-label-sm text-label-sm uppercase tracking-wider text-outline">Dispatch Average ETA</span>
              <span class="inline-flex items-center gap-1 text-secondary-fixed-dim font-label-sm text-label-sm font-bold">
                <span class="material-symbols-outlined text-[14px]">bolt</span> PRIORITY TIER
              </span>
            </div>
            <div class="flex items-baseline gap-2">
              <span class="font-metric-mono text-metric-mono text-primary font-bold">28:40</span>
              <span class="font-body-sm text-body-sm text-on-surface-variant">mins nationwide average</span>
            </div>
            <div class="w-full bg-surface-container-highest h-1 rounded-full overflow-hidden">
              <div class="bg-primary-container h-full w-[78%] rounded-full"></div>
            </div>
            <div class="flex items-center justify-between text-on-surface-variant font-label-sm text-label-sm pt-1">
              <span>Call Queue: 0 callers</span>
              <span>All UK Motorways Active</span>
            </div>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-space-md pt-space-xs">
          <a
            class="inline-flex items-center justify-center gap-space-sm px-space-xl py-space-md rounded-full bg-primary-container text-on-primary-container font-headline-sm text-headline-sm transition-all transform hover:scale-[1.02] shadow-[0_0_28px_rgba(0,242,254,0.45)] hover:shadow-[0_0_36px_rgba(0,242,254,0.7)]"
            href="tel:0800247999"
          >
            <span class="material-symbols-outlined text-[24px]">call</span>
            <span>Call Now: 0800 247 999</span>
          </a>
          <a
            class="inline-flex items-center justify-center gap-space-sm px-space-lg py-space-md rounded-full bg-surface-container hover:bg-surface-container-high text-primary font-label-lg text-label-lg transition-all shadow-md"
            href="#intake-form"
          >
            <span class="material-symbols-outlined text-[20px] text-primary-container">near_me</span>
            <span>Request Assistance Online</span>
          </a>
          <div class="flex items-center gap-space-xs text-on-surface-variant font-label-md text-label-md ml-auto">
            <span class="material-symbols-outlined text-secondary-fixed-dim text-[18px]">verified_user</span>
            <span>Zero upfront registration fees</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. THREE DIRECT CONTACT CHANNELS -->
    <section class="w-full px-gutter-sm lg:px-margin py-space-lg">
      <div class="max-w-7xl mx-auto flex flex-col gap-space-md">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-xs">
          <span class="font-label-sm text-label-sm uppercase tracking-widest text-outline">COMMUNICATION VECTORS • PRIORITY TRIAGE</span>
          <span class="font-label-sm text-label-sm text-on-surface-variant">AVERAGE CONNECTION: UNDER 12 SEC</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
          <a class="group flex flex-col justify-between p-space-lg rounded-xl bg-surface-container-low hover:bg-surface-container transition-all shadow-lg hover:shadow-[0_12px_32px_rgba(0,0,0,0.6)]" href="tel:0800247999">
            <div class="flex flex-col gap-space-md">
              <div class="flex items-center justify-between">
                <span class="font-label-sm text-label-sm text-error uppercase tracking-widest font-bold">01 • VOICE DISPATCH</span>
                <span class="px-space-xs py-0.5 rounded-full bg-error/15 text-error font-label-sm text-label-sm">EMERGENCY FIRST</span>
              </div>
              <div>
                <h2 class="font-headline-md text-headline-md text-on-surface group-hover:text-primary transition-colors">Call Emergency Hotline</h2>
                <p class="font-body-md text-body-md text-on-surface-variant mt-space-xs">
                  Direct hotline to senior UK transport coordinators. Immediate assessment, GPS localization, and flatbed truck allocation.
                </p>
              </div>
            </div>
            <div class="pt-space-lg flex items-center justify-between">
              <div>
                <span class="block font-label-sm text-label-sm uppercase text-outline">Toll-Free Priority</span>
                <span class="font-headline-sm text-headline-sm text-primary-container">0800 247 999</span>
              </div>
              <div class="w-10 h-10 rounded-full bg-surface-container-high flex items-center justify-center text-primary group-hover:bg-primary-container group-hover:text-on-primary-container transition-all">
                <span class="material-symbols-outlined text-[20px]">north_east</span>
              </div>
            </div>
          </a>

          <a class="group flex flex-col justify-between p-space-lg rounded-xl bg-surface-container-low hover:bg-surface-container transition-all shadow-lg hover:shadow-[0_12px_32px_rgba(0,0,0,0.6)]" href="mailto:dispatch@autoassist247.co.uk">
            <div class="flex flex-col gap-space-md">
              <div class="flex items-center justify-between">
                <span class="font-label-sm text-label-sm text-tertiary-fixed-dim uppercase tracking-widest font-bold">02 • LOGISTICS & FLEET</span>
                <span class="px-space-xs py-0.5 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-label-sm">COMMERCIAL</span>
              </div>
              <div>
                <h2 class="font-headline-md text-headline-md text-on-surface group-hover:text-primary transition-colors">Email & Commercial Accounts</h2>
                <p class="font-body-md text-body-md text-on-surface-variant mt-space-xs">
                  Pre-scheduled dealer transfers, corporate fleet SLAs, high-value enclosed transit, and insurance invoicing inquiries.
                </p>
              </div>
            </div>
            <div class="pt-space-lg flex items-center justify-between">
              <div class="min-w-0">
                <span class="block font-label-sm text-label-sm uppercase text-outline">Direct Inbox</span>
                <span class="font-label-lg text-label-lg text-on-surface truncate block">dispatch@autoassist247.co.uk</span>
              </div>
              <div class="w-10 h-10 rounded-full bg-surface-container-high flex items-center justify-center text-primary group-hover:bg-primary-container group-hover:text-on-primary-container transition-all shrink-0">
                <span class="material-symbols-outlined text-[20px]">mail</span>
              </div>
            </div>
          </a>

          <a class="group flex flex-col justify-between p-space-lg rounded-xl bg-surface-container-low hover:bg-surface-container transition-all shadow-lg hover:shadow-[0_12px_32px_rgba(0,0,0,0.6)]" href="#intake-form">
            <div class="flex flex-col gap-space-md">
              <div class="flex items-center justify-between">
                <span class="font-label-sm text-label-sm text-primary-container uppercase tracking-widest font-bold">03 • DIGITAL TELEMETRY</span>
                <span class="px-space-xs py-0.5 rounded-full bg-primary-container/10 text-primary-container font-label-sm text-label-sm">LIVE SMS LINK</span>
              </div>
              <div>
                <h2 class="font-headline-md text-headline-md text-on-surface group-hover:text-primary transition-colors">Request Online Now</h2>
                <p class="font-body-md text-body-md text-on-surface-variant mt-space-xs">
                  Submit breakdown parameters, upload vehicle details, receive fixed transparent quotation, and track your driver in real time.
                </p>
              </div>
            </div>
            <div class="pt-space-lg flex items-center justify-between">
              <div>
                <span class="block font-label-sm text-label-sm uppercase text-outline">Self-Serve Platform</span>
                <span class="font-headline-sm text-headline-sm text-secondary-fixed-dim">Instant Dispatch</span>
              </div>
              <div class="w-10 h-10 rounded-full bg-surface-container-high flex items-center justify-center text-primary group-hover:bg-primary-container group-hover:text-on-primary-container transition-all">
                <span class="material-symbols-outlined text-[20px]">arrow_downward</span>
              </div>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- 3. URGENT HIGHWAY SAFETY WARNING -->
    <section class="w-full px-gutter-sm lg:px-margin py-space-md">
      <div class="max-w-7xl mx-auto rounded-2xl bg-surface-container-high/90 overflow-hidden shadow-2xl relative">
        <div class="absolute inset-0 bg-gradient-to-r from-error-container/40 via-surface-container-high/20 to-transparent pointer-events-none"></div>
        <div class="relative z-10 p-space-lg lg:p-space-xl flex flex-col lg:flex-row items-start lg:items-center justify-between gap-space-lg">
          <div class="flex flex-col gap-space-xs max-w-2xl">
            <div class="flex items-center gap-space-xs text-error font-label-sm text-label-sm uppercase tracking-widest font-bold">
              <span class="material-symbols-outlined text-[18px]">warning</span>
              <span>CRITICAL HIGHWAY SAFETY ADVISORY</span>
            </div>
            <h2 class="font-headline-lg text-headline-lg text-on-surface font-black tracking-tight">
              STRANDED ON A LIVE MOTORWAY OR DUAL CARRIAGEWAY?
            </h2>
            <p class="font-body-md text-body-md text-on-surface-variant">
              Exit through the passenger-side doors immediately. Stand well behind the steel crash barrier on the verge slope. Do NOT remain seated inside the vehicle while waiting.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-space-md w-full lg:w-auto">
            <a class="flex items-center justify-center gap-space-sm px-space-xl py-space-md rounded-xl bg-error text-on-error font-headline-sm text-headline-sm shadow-[0_0_32px_rgba(255,180,171,0.3)] hover:brightness-110 transition-all" href="tel:0800247999">
              <span class="material-symbols-outlined text-[26px]">fmd_bad</span>
              <span>Call 0800 247 999</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. ASSISTANCE REQUEST FORM + PHOTO -->
    <section class="w-full px-gutter-sm lg:px-margin py-space-xl scroll-mt-24" id="intake-form">
      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-gutter items-start">
        <div class="lg:col-span-5 flex flex-col gap-space-lg">
          <div class="flex flex-col gap-space-xs">
            <span class="font-label-sm text-label-sm uppercase tracking-widest text-primary-container">PRECISION INTAKE DESK</span>
            <h2 class="font-headline-lg text-headline-lg text-on-surface">Request Assistance In Under 90 Seconds</h2>
            <p class="font-body-md text-body-md text-on-surface-variant">
              Fill out your current vehicle status and position. Our dispatch algorithm automatically assigns the closest certified flatbed transporter or roadside technician.
            </p>
          </div>

          <div class="relative rounded-2xl overflow-hidden shadow-2xl bg-surface-container-low group">
            <div class="relative w-full h-72">
              <Image
                src={intakeImg}
                alt="A yellow and white flatbed recovery truck on a British motorway hard shoulder at dusk, with a technician in high-visibility gear securing a broken down car."
                width={800}
                height={576}
                quality={70}
                loading="lazy"
                decoding="async"
                class="absolute inset-0 w-full h-full object-cover"
              />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-surface-container-lowest/30 to-transparent"></div>
            <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between">
              <div class="flex flex-col">
                <span class="font-label-sm text-label-sm text-primary-container uppercase">National Heavy & Light Fleet</span>
                <span class="font-label-md text-label-md text-on-surface">ISO-9001 Certified Operators</span>
              </div>
              <span class="px-2 py-1 rounded bg-surface-container-high/90 text-secondary-fixed-dim font-label-sm text-label-sm">LIVE UNIT READY</span>
            </div>
          </div>

          <div class="p-space-md rounded-xl bg-surface-container-low flex flex-col gap-space-sm shadow-md">
            <div class="flex items-center gap-space-sm">
              <span class="material-symbols-outlined text-secondary-fixed-dim text-[20px]">check_circle</span>
              <span class="font-label-md text-label-md text-on-surface">Fixed upfront pricing with no hidden mileage penalties</span>
            </div>
            <div class="flex items-center gap-space-sm">
              <span class="material-symbols-outlined text-secondary-fixed-dim text-[20px]">check_circle</span>
              <span class="font-label-md text-label-md text-on-surface">Live SMS telematics link with real-time GPS truck pin</span>
            </div>
            <div class="flex items-center gap-space-sm">
              <span class="material-symbols-outlined text-secondary-fixed-dim text-[20px]">check_circle</span>
              <span class="font-label-md text-label-md text-on-surface">Licensed operators for motorway, A-road, and underground parking</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7 rounded-2xl bg-surface-container-low/90 backdrop-blur-xl p-space-lg lg:p-space-xl shadow-2xl flex flex-col gap-space-lg">
          <div class="flex items-center justify-between pb-space-xs">
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-primary-container"></span>
              <span class="font-label-sm text-label-sm uppercase tracking-wider text-on-surface">DIRECT DISPATCH TELEMETRY INTAKE</span>
            </div>
            <span class="font-label-sm text-label-sm text-outline">SECURE 256-BIT SSL</span>
          </div>

          <form class="flex flex-col gap-space-md" id="roadside-form">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
              <div class="flex flex-col gap-space-xs">
                <label class="font-label-sm text-label-sm uppercase text-outline" for="caller-name">Full Name *</label>
                <div class="relative flex items-center">
                  <span class="material-symbols-outlined absolute left-3 text-on-surface-variant text-[18px]">person</span>
                  <input class="w-full bg-surface-container py-3 pl-10 pr-4 rounded-lg text-on-surface placeholder:text-outline-variant font-body-md text-body-md focus:outline-none focus:bg-surface-container-high transition-colors" id="caller-name" name="caller-name" placeholder="e.g. David Henderson" required type="text" />
                </div>
              </div>
              <div class="flex flex-col gap-space-xs">
                <label class="font-label-sm text-label-sm uppercase text-outline" for="caller-phone">Mobile Contact Number *</label>
                <div class="relative flex items-center">
                  <span class="material-symbols-outlined absolute left-3 text-on-surface-variant text-[18px]">smartphone</span>
                  <input class="w-full bg-surface-container py-3 pl-10 pr-4 rounded-lg text-on-surface placeholder:text-outline-variant font-body-md text-body-md focus:outline-none focus:bg-surface-container-high transition-colors" id="caller-phone" name="caller-phone" placeholder="07123 456789" required type="tel" />
                </div>
              </div>
            </div>

            <div class="flex flex-col gap-space-xs">
              <div class="flex items-center justify-between">
                <label class="font-label-sm text-label-sm uppercase text-outline" for="breakdown-loc">Current Breakdown Location *</label>
                <button class="text-primary-container hover:text-primary font-label-sm text-label-sm flex items-center gap-1 transition-colors" id="use-gps" type="button">
                  <span class="material-symbols-outlined text-[14px]">my_location</span> Use My Live GPS
                </button>
              </div>
              <div class="relative flex items-center">
                <span class="material-symbols-outlined absolute left-3 text-primary-container text-[18px]">location_on</span>
                <input class="w-full bg-surface-container py-3 pl-10 pr-4 rounded-lg text-on-surface placeholder:text-outline-variant font-body-md text-body-md focus:outline-none focus:bg-surface-container-high transition-colors" id="breakdown-loc" name="breakdown-loc" placeholder="Postcode, Motorway & Junction (e.g. M1 Northbound near J14), or what3words" required type="text" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
              <div class="flex flex-col gap-space-xs">
                <label class="font-label-sm text-label-sm uppercase text-outline" for="vehicle-vrm">Vehicle Registration (VRM) *</label>
                <div class="relative flex items-center">
                  <span class="material-symbols-outlined absolute left-3 text-on-surface-variant text-[18px]">directions_car</span>
                  <input class="w-full uppercase tracking-wider bg-surface-container py-3 pl-10 pr-4 rounded-lg text-primary-container placeholder:text-outline-variant font-label-lg text-label-lg focus:outline-none focus:bg-surface-container-high transition-colors" id="vehicle-vrm" name="vehicle-vrm" placeholder="e.g. EA19 FXL" required type="text" />
                </div>
              </div>
              <div class="flex flex-col gap-space-xs">
                <label class="font-label-sm text-label-sm uppercase text-outline" for="vehicle-model">Make & Model (Optional)</label>
                <div class="relative flex items-center">
                  <span class="material-symbols-outlined absolute left-3 text-on-surface-variant text-[18px]">commute</span>
                  <input class="w-full bg-surface-container py-3 pl-10 pr-4 rounded-lg text-on-surface placeholder:text-outline-variant font-body-md text-body-md focus:outline-none focus:bg-surface-container-high transition-colors" id="vehicle-model" name="vehicle-model" placeholder="e.g. BMW 3 Series Touring / EV" type="text" />
                </div>
              </div>
            </div>

            <div class="flex flex-col gap-space-xs">
              <label class="font-label-sm text-label-sm uppercase text-outline" for="service-type">Service Required *</label>
              <div class="relative flex items-center">
                <span class="material-symbols-outlined absolute left-3 text-on-surface-variant text-[18px]">build_circle</span>
                <select class="w-full bg-surface-container py-3 pl-10 pr-10 rounded-lg text-on-surface font-body-md text-body-md focus:outline-none focus:bg-surface-container-high transition-colors appearance-none cursor-pointer" id="service-type" name="service-type" required>
                  <option disabled selected value="">Select Roadside Assistance Type</option>
                  <option value="flatbed-towing">Flatbed Towing & Complete Vehicle Recovery</option>
                  <option value="battery-boost">12V Battery Boost & Alternator Diagnostics</option>
                  <option value="mobile-tyre">Emergency Mobile Tyre Fitting / Puncture</option>
                  <option value="misfuel-drain">Misfuel Drainage (Petrol / Diesel mix)</option>
                  <option value="ev-assistance">Electric Vehicle (EV) Flatbed Recovery</option>
                  <option value="lockout">Vehicle Lockout Assistance</option>
                </select>
                <span class="material-symbols-outlined absolute right-3 text-outline pointer-events-none text-[20px]">expand_more</span>
              </div>
            </div>

            <div class="flex flex-col gap-space-xs">
              <label class="font-label-sm text-label-sm uppercase text-outline" for="incident-details">Incident Details</label>
              <textarea class="w-full bg-surface-container p-3 rounded-lg text-on-surface placeholder:text-outline-variant font-body-md text-body-md focus:outline-none focus:bg-surface-container-high transition-colors resize-none" id="incident-details" name="incident-details" placeholder="Describe the symptom or location context (e.g., car won't turn over, steering locked, located in multi-storey level 3, 2 passengers onboard)..." rows="3"></textarea>
            </div>

            <button class="mt-space-xs w-full py-space-md rounded-xl bg-primary-container hover:bg-primary-fixed-dim text-on-primary-container font-headline-sm text-headline-sm transition-all shadow-[0_0_24px_rgba(0,242,254,0.4)] hover:shadow-[0_0_36px_rgba(0,242,254,0.6)] flex items-center justify-center gap-space-sm" type="submit">
              <span>Request Immediate Assistance</span>
              <span class="material-symbols-outlined text-[22px]">send</span>
            </button>

            <div class="flex items-center justify-between text-on-surface-variant font-label-sm text-label-sm pt-space-xs">
              <span>Guaranteed Dispatch Priority</span>
              <span>Zero Callout Markup Guarantee</span>
            </div>

            <div class="hidden p-space-md rounded-lg bg-secondary-container text-on-secondary-container font-label-md text-label-md items-center gap-2" id="form-feedback">
              <span class="material-symbols-outlined text-[20px]">task_alt</span>
              <span>Intake received. Our controller is phoning your mobile right now with driver ETA and transparent quotation.</span>
            </div>
          </form>
        </div>
      </div>
    </section>

    <!-- 5. WHAT TO TELL US -->
    <section class="w-full px-gutter-sm lg:px-margin py-space-xl">
      <div class="max-w-7xl mx-auto rounded-3xl bg-surface-container-low p-space-lg lg:p-space-2xl shadow-xl flex flex-col gap-space-xl">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md">
          <div class="flex flex-col gap-space-xs">
            <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary-fixed-dim">OPTIMIZING YOUR DISPATCH TIME</span>
            <h2 class="font-headline-lg text-headline-lg text-on-surface">Help Us Help You Faster</h2>
          </div>
          <p class="font-body-md text-body-md text-on-surface-variant max-w-md">
            Having these 6 operational parameters ready when contacting our national desk shaves up to 15 minutes off your rescue timeline.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
          {[
            { icon: 'pin_drop', badge: 'bg-secondary-fixed-dim/20 text-secondary-fixed-dim', title: 'Exact Location', desc: 'Motorway marker post blue signs (found every 100m on verges), motorway junction, or a 3-word coordinate via what3words.' },
